# Copy to .env and fill in. Never commit your real key.
GNANI_API_KEY=
# Prisma: leave empty for the default (v2.5) or set prisma-v3.0
PRISMA_MODEL=
STT_LANGUAGE=hi-IN
# 1 = use Prisma realtime WebSocket instead of REST
STT_REALTIME=0
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE=Nalini
TTS_SAMPLE_RATE=16000
# Evon v3.3 served with vLLM or a Hugging Face endpoint (OpenAI-compatible). Optional.
EVON_BASE_URL=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_API_KEY=
# auto | mock | live
SAATHI_MODE=auto
PORT=8930

# --- security ---
# first-run admin password for the officer console (otherwise a random one is printed)
SAATHI_ADMIN_PASSWORD=
# set HTTPS=1 behind TLS so the session cookie gets the Secure flag; TRUST_PROXY=1 to use X-Forwarded-For
HTTPS=0
TRUST_PROXY=0

# --- telephony (optional) ---
# shared secret that signs the Twilio stream token (random per start if empty)
TELEPHONY_SECRET=
# Twilio auth token: when set, /twilio/voice rejects requests without a valid X-Twilio-Signature
TWILIO_AUTH_TOKEN=
# key the Exotel Voicebot URL must carry: wss://<host>/exotel/stream?key=...
EXOTEL_STREAM_KEY=

# --- real-voice evaluation (optional) ---
# volunteers open /collect.html?key=<COLLECT_KEY>
COLLECT_KEY=
